# direnv: keep the uv-managed virtualenv in sync and activate it.
# Run `direnv allow` once (and again after editing this file).

if ! has uv; then
  log_error "uv not found; install it from https://docs.astral.sh/uv/"
  exit 1
fi

# Re-run when the Python dependencies change.
watch_file pyproject.toml uv.lock .python-version

uv sync --quiet

export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"
